# Brad — AI CMO Agent Configuration
# Copy to .env and fill in your values

# ── LLM Backend (pick one or configure multiple) ──────────────
# Options: openai, anthropic, lana, ollama
BRAD_LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# LANA-AI (local, free)
LANA_API_URL=http://localhost:8080/api/v1
LANA_API_TOKEN=your-jwt-token
LANA_MODEL=lana-default

# Ollama (local, free)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── Platform API Keys ─────────────────────────────────────────
# Reddit (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=brad:v0.1.0 (by /u/your_username)

# Twitter/X (https://developer.twitter.com)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ── Google APIs (enriches SEO audit with real data) ───────────
# Service account JSON key file (shared by GSC + GA4)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Google Search Console
# Site URL as registered in GSC (e.g., https://lanaai.io/ or sc-domain:lanaai.io)
GSC_SITE_URL=

# Google Analytics 4
# IMPORTANT: This must be the NUMERIC property ID, not the measurement ID (G-XXXXXXX)
# Find it in GA4: Admin → Property Settings → Property ID
GA4_PROPERTY_ID=

# ── Agent Behavior ────────────────────────────────────────────
# require = must approve before posting. auto = fire and forget
BRAD_APPROVAL_MODE=require
# How verbose: silent, normal, verbose
BRAD_LOG_LEVEL=normal
